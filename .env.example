DATABASE_URL=postgres://radar:radar_dev_only@localhost:55432/radar
POSTGRES_PASSWORD=radar_dev_only

# Binance Web3 API (https://web3.binance.com/en/dev-portal) — optional.
# Leave both empty to run entirely on demo data. When set, the API fetches
# live tokenized-stock prices (RWA Data API) at startup and every 60s, and
# uses the Trading API for real executable quotes where a token's contract
# address is known. See backend/src/binance.rs and backend/src/live.rs.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Override only for testing against a non-production host.
# BINANCE_API_HOST=https://web3.binance.com

# OpenAI (https://platform.openai.com) — optional, powers the Phase 5 LLM
# intent parser at POST /api/agent/parse (architecture doc section 11).
# Leave empty to keep the frontend's rule-based DSL parser only. The model
# only proposes numbers via a schema-constrained call; the backend
# independently re-validates every value against the same hard limits
# create_policy already enforces. See backend/src/agent.rs.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra
# OPENAI_API_HOST=https://api.openai.com/v1/responses
